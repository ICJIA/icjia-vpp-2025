{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "app/composables/*.ts",
    "app/composables/*.js",
    "app/utils/*.ts",
    "app/utils/*.js",
    "app/plugins/*.ts",
    "app/plugins/*.js",
    "docs-temp/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".nuxt",
    ".output",
    "test",
    "tests"
  ]
}

