  "features": {
    "search": {
      "enabled": true,
      "provider": "fuse.js",
      "minCharacters": 3
    },
    "themes": {
      "enabled": true,
      "default": "dark",
      "options": [
        "light",
        "dark"
      ]
    },
    "accessibility": {
      "wcagLevel": "AA"
    },
    "analytics": {
      "enabled": false,
      "provider": null
    }
  },
  "ui": {
    "tableOfContents": {
      "defaultLabel": "Jump To..."
