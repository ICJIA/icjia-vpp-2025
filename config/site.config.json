    "navigation": {
      "readThePlanMenu": {
        "enabled": true,
        "mobileText": "Read the Plan",
        "ariaLabel": "Read the Plan - Violence Prevention Plan for Illinois",
        "items": {
          "cover": {
            "enabled": true,
            "text": "Cover: Statewide Violence Plan for Illinois: 2025-2029",
            "to": "/plan/front-cover",
            "ariaLabel": "View the cover page of the violence prevention plan"
          },
          "executive-summary": {
            "enabled": true,
            "text": "Executive Summary",
