            "icon": "mdi-translate",
            "ariaLabel": "Translate page",
            "tooltip": "Translate page",
            "isExternal": false
          }
        },
        "accessibility": {
          "announceMenuState": true,
          "keyboardNavigation": true,
          "focusManagement": true,
          "contrastRatio": "8:1"
        },
        "behavior": {
          "closeOnClickOutside": true,
          "closeOnEscape": true,
          "openOnHover": false,
          "transitionDuration": "250ms"
        }
      }
    }
  },
  "routing": {
    "blacklist": {
      "vue": [
        "sandbox.vue",
        "sandbox-*.vue",
        "[...slug].vue"
      ],
      "markdown": [
        "sandbox.md",
        "sandbox-*.md"
      ]
    },
    "titleExtraction": {
      "fallbackPattern": "Statewide Violence Prevention Plan for Illinois: 2025-2029",
      "maxLength": 100
    }
  },
  "logging": {
    "level": "NORMAL",
    "showTimestamp": true,
    "showPrefix": true,
    "groupMessages": true,
    "buildSummary": true,
    "colors": {
      "success": "#27ae60",
      "error": "#e74c3c",
      "warning": "#f39c12",
      "info": "#3498db",
      "debug": "#7f8c8d"
    }
  },
  "build": {
    "environment": "production",
    "generatedAt": "2025-05-25T00:00:00.000Z",
    "nodeVersion": null,
    "nuxtVersion": null
  }
