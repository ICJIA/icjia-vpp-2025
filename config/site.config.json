            "ariaLabel": "Read the executive summary of our violence prevention plan"
          },
          "public-health-approach": {
            "enabled": true,
            "text": "Violence Prevention from a Public Health Approach",
            "to": "/plan/public-health-approach",
            "ariaLabel": "Learn about our public health approach to violence prevention"
          },
          "guiding-principles": {
            "enabled": true,
            "text": "Guiding Principles",
            "to": "/plan/guiding-principles",
            "ariaLabel": "View our guiding principles"
          },
          "planning-process": {
            "enabled": true,
            "text": "Planning Process",
            "to": "/plan/planning-process",
            "ariaLabel": "View our planning process"
          },
          "goals-and-recommendations": {
            "enabled": true,
            "text": "Goals and Recommendations",
            "to": "/plan/goals-and-recommendations",
            "ariaLabel": "View our goals and recommendations"
          },
          "references": {
            "enabled": true,
            "text": "References",
            "to": "/plan/references",
            "ariaLabel": "View references and bibliography"
          }
        }
      },
      "moreMenu": {
        "enabled": true,
        "desktopIcon": "mdi-dots-horizontal",
        "mobileText": "More",
        "ariaLabel": "More options menu",
        "items": {
          "resources": {
            "enabled": true,
            "text": "Resources",
            "to": "/resources",
            "icon": "mdi-book-open-variant",
            "ariaLabel": "View resources",
            "tooltip": "View resources"
          },
          "highlights": {
            "enabled": true,
            "text": "Organizational and Agency Highlights",
            "to": "/organizational-and-agency-highlights",
            "icon": "mdi-trophy",
            "ariaLabel": "View organizational and agency highlights",
            "tooltip": "View organizational and agency highlights"
          },
          "divider": {
            "enabled": true,
            "isDivider": true
          },
          "news": {
            "enabled": false,
            "text": "News & Updates",
            "to": "/news",
            "icon": "mdi-newspaper",
            "ariaLabel": "View news and updates",
            "tooltip": "Latest News and Updates"
          },
          "search": {
            "enabled": true,
            "text": "Search",
            "to": "/search",
            "icon": "mdi-magnify",
            "ariaLabel": "Search",
            "tooltip": "Search"
          },
          "contact": {
            "enabled": true,
            "text": "Contact",
            "to": "/contact",
            "icon": "mdi-email-outline",
            "ariaLabel": "Contact us",
            "tooltip": "Contact us"
          },
          "translate": {
            "enabled": false,
            "text": "Translate",
