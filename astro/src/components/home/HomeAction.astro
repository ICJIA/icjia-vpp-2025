---
/**
 * HomeAction — 3-card "For More Information" grid section.
 *
 * Props: { action } — { heading, subtitle, cards:[{title, description, icon, buttonText, url}] }
 *   from astro/src/data/home.js → action export.
 *
 * Source: app/components/content/HomeAction.vue
 *
 * Section band: .section-primary (full-bleed on <section>).
 * Each card is a whole-card <a> link wrapping a grid-rows layout so
 * the decorative pill button is always pinned to the bottom.
 * Entrance stagger: fadeSlideUp 0/0.2/0.4s per card,
 *   gated to (prefers-reduced-motion: no-preference).
 */
import { Icon } from "astro-icon/components";

const { action } = Astro.props;
---

<section class="section-primary py-16">
  <div class="container mx-auto px-4 max-w-screen-xl">
    <!-- Centered section header -->
    <h2 class="text-center text-5xl min-[960px]:text-6xl font-bold border-b border-on-surface/20 pb-3 mb-6">
      {action.heading}
    </h2>
    <p class="text-center text-xl text-on-surface max-w-[800px] mx-auto mb-12">
      {action.subtitle}
    </p>

    <!-- 3-column action card grid -->
    <div
      class="grid grid-cols-1 min-[600px]:grid-cols-2 min-[900px]:grid-cols-3 gap-6 min-[600px]:gap-8"
    >
      {
        action.cards.map((card, index) => (
          <a
            href={card.url}
            class:list={[
              "action-card",
              `action-card-${index}`,
              "grid grid-rows-[auto_auto_1fr_auto]",
              "min-h-[320px] min-[1024px]:min-h-[350px]",
              "p-6 min-[1024px]:p-8",
              "rounded-xl bg-surface dark:bg-[#2a3441]",
              "border border-black/5",
              "shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1)]",
              "no-underline text-center",
              "transition-transform hover:-translate-y-2 hover:shadow-lg",
              "focus-visible:outline-2 focus-visible:outline-primary",
            ]}
          >
            {/* Row 1 — Icon */}
            <Icon
              name={card.icon}
              class="w-16 h-16 text-primary mx-auto mb-4"
              aria-hidden="true"
            />

            {/* Row 2 — Title */}
            <h3 class="text-[2rem] min-[1024px]:text-[2.25rem] font-extrabold tracking-[-0.025em] text-on-surface mb-3">
              {card.title}
            </h3>

            {/* Row 3 — Description (1fr, grows to fill space) */}
            <p class="text-[0.9375rem] leading-relaxed text-on-surface/87">
              {card.description}
            </p>

            {/* Row 4 — Decorative pill button pinned to bottom */}
            <span
              class="inline-flex items-center gap-1 mt-4 mx-auto rounded-full border-2 border-primary text-primary font-semibold px-4 py-1.5 min-w-[120px] justify-center"
              aria-hidden="true"
            >
              {card.buttonText}
              <Icon name="mdi:arrow-right" class="w-4 h-4" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /*
   * Entrance stagger animation — gated to no-preference for reduced motion.
   * Cards 0/1/2 get 0s / 0.2s / 0.4s delay respectively.
   * Users who prefer reduced motion see the final state immediately
   * (no opacity:0 / no keyframe applied).
   */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .action-card {
      opacity: 0;
      animation: fadeSlideUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

    .action-card-0 {
      animation-delay: 0s;
    }

    .action-card-1 {
      animation-delay: 0.2s;
    }

    .action-card-2 {
      animation-delay: 0.4s;
    }
  }
</style>
