---
/**
 * NewsCard — horizontal card for news listing.
 * Ported from app/components/content/NewsCard.vue.
 *
 * Layout: 200px image left | date chip + title + summary + "Read More" right.
 * Stacks to single column on ≤768px with 150px image row.
 * Image fallback: /images/illinois-seal.webp
 */

interface Props {
  id: string;
  title?: string;
  summary?: string;
  date?: Date;
  image?: string;
  href: string;
}

const { id, title = "Untitled", summary = "", date, image, href } = Astro.props;

function formatDate(d: Date): string {
  try {
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    });
  } catch {
    return d.toString();
  }
}

const formattedDate = date ? formatDate(date) : null;
const imgSrc = image || "/images/illinois-seal.webp";
const imgAlt = image ? `Image for ${title}` : "Illinois State Seal";
---

<article
  class="news-card rounded-xl border border-on-surface/10 bg-surface overflow-hidden shadow
         hover:-translate-y-0.5 transition-transform duration-200
         focus-within:ring-2 focus-within:ring-primary focus-within:ring-offset-2"
>
  <a href={href} class="block h-full no-underline text-inherit" aria-label={`Read more about ${title}`}>
    <div class="news-card-grid">
      <!-- Image -->
      <div class="news-image-wrap">
        <img
          src={imgSrc}
          alt={imgAlt}
          class="object-cover h-full w-full"
          loading="lazy"
        />
      </div>

      <!-- Content -->
      <div class="news-content p-6 flex flex-col gap-3">
        {formattedDate && (
          <div class="news-date">
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium
                     bg-black/10 text-black/85 border border-black/15
                     dark:bg-white/10 dark:text-white/90 dark:border-white/20"
            >
              <!-- Calendar icon -->
              <svg
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-3.5 h-3.5 shrink-0"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              <time datetime={date?.toISOString().split("T")[0]}>{formattedDate}</time>
            </span>
          </div>
        )}

        <h2 class="text-xl font-bold leading-snug text-on-surface/95 line-clamp-2 m-0">
          {title}
        </h2>

        {summary && (
          <p class="text-sm leading-relaxed text-on-surface/75 line-clamp-3 m-0">
            {summary}
          </p>
        )}

        <div class="mt-auto pt-1">
          <span class="text-sm font-medium text-primary hover:underline">
            Read More →
          </span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .news-card-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    min-height: 200px;
    height: 100%;
  }

  .news-image-wrap {
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  @media (max-width: 768px) {
    .news-card-grid {
      grid-template-columns: 1fr;
      grid-template-rows: 150px 1fr;
    }
  }
</style>
