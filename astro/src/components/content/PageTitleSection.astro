---
/**
 * PageTitleSection — title band atop content pages.
 * Ported from app/components/content/PageTitleSection.vue.
 *
 * Props
 *   title        {string}          — main heading text
 *   description  {string}          — optional subtitle paragraph
 *   showBorder   {boolean=false}   — adds border-bottom separator
 *   date         {string}          — YYYY-MM-DD, used when showDate is true
 *   showDate     {boolean=false}   — renders the date chip between h1 and description
 */

interface Props {
  title: string;
  description?: string;
  showBorder?: boolean;
  date?: string;
  showDate?: boolean;
}

const {
  title,
  description,
  showBorder = false,
  date,
  showDate = false,
} = Astro.props;

/** Format YYYY-MM-DD → "Month DD, YYYY" (matches legacy formattedDate). */
function formatDate(raw: string): string {
  try {
    // Parse as UTC midnight so no timezone shift affects the displayed day.
    const d = new Date(`${raw}T00:00:00Z`);
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    });
  } catch {
    return raw;
  }
}

const showDateChip = showDate && !!date;
const formattedDate = showDateChip ? formatDate(date!) : "";
---

<section
  class:list={[
    "pts-section",
    "flex items-center justify-center",
    "min-h-[25vh]",
    "bg-[#eeeeee] dark:bg-[#1b2530]",
    showBorder && "border-b border-on-surface/12",
  ]}
>
  <div class="text-center max-w-[900px] w-full px-6 py-8">

    <h1
      class="pts-title font-bold leading-[1.1] tracking-[-0.03em] text-on-surface/95
             text-[5rem] max-[960px]:text-[4rem] max-[768px]:text-[3rem] max-[600px]:text-[2.25rem]
             font-sans mb-6"
    >
      {title}
    </h1>

    {showDateChip && (
      <div class="pts-date mt-8 mb-6 flex justify-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                 text-sm font-medium
                 border
                 bg-black/10 text-black/85 border-black/15
                 dark:bg-white/10 dark:text-white/90 dark:border-white/20"
        >
          {/* Calendar icon — inline SVG, no icon library needed */}
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-4 h-4 shrink-0"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
          </svg>
          <time datetime={date}>{formattedDate}</time>
        </div>
      </div>
    )}

    {description && (
      <p
        class="pts-desc text-lg leading-relaxed text-on-surface/80
               max-w-[800px] mx-auto mt-4"
      >
        {description}
      </p>
    )}

  </div>
</section>

<style>
  /*
   * Fade-in: opacity-only (no transform) to avoid CLS.
   * Gated behind prefers-reduced-motion: no-preference so reduced-motion
   * users receive opacity:1 immediately (no animation, fully visible).
   */
  @media (prefers-reduced-motion: no-preference) {
    .pts-title {
      opacity: 0;
      animation: pts-fade 0.8s 0.2s forwards;
    }
    .pts-date {
      opacity: 0;
      animation: pts-fade 0.8s 0.3s forwards;
    }
    .pts-desc {
      opacity: 0;
      animation: pts-fade 0.8s 0.4s forwards;
    }
  }

  @keyframes pts-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
