---
/**
 * TextCenteredImage — Phase 3 implementation (inline only).
 * Matches legacy TextCenteredImage.vue visual: centered figure, constrained image,
 * rounded corners, drop shadow, bold caption, muted secondary note.
 *
 * TODO(Phase 5): click-to-enlarge modal (legacy used a Vuetify v-dialog)
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Override max-width of the image (e.g. "600px", "80%"). Defaults to 720px. */
  maxWidth?: string;
}

const { src, alt, caption, maxWidth = "720px" } = Astro.props;
---

<figure class="text-centered-image my-8 text-center">
  <img
    src={src}
    alt={alt}
    style={`max-width: ${maxWidth};`}
    class="mx-auto block w-full h-auto rounded shadow-md"
    loading="lazy"
  />
  {caption && (
    <figcaption class="mt-3 text-sm font-bold text-center text-on-surface/70 italic">
      {caption}
    </figcaption>
  )}
</figure>
