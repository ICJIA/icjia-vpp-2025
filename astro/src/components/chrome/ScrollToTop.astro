---
/**
 * ScrollToTop — always-visible fixed floating action button.
 *
 * Permanently visible in the bottom-right corner (NO scroll threshold).
 * Scrolls to the top of the page respecting prefers-reduced-motion.
 *
 * Design:
 *  - 48px circular FAB (44px on mobile <600px)
 *  - bg-primary with auto-contrasting icon:
 *      light theme: bg-primary = #0747a6 (dark blue) → white icon
 *      dark  theme: bg-primary = #93c5fd (light blue) → dark icon via dark:text-[#0f172a]
 *  - Hover: -translate-y-0.5 + shadow-xl
 *  - Focus: 2px outline-primary with 2px offset
 *  - Respects prefers-reduced-motion (no transition, instant scroll)
 *
 * Gotcha #12 (brief): ALWAYS visible — no show/hide-on-scroll logic.
 * A native <button> already handles Enter/Space, so no extra keyboard wiring.
 */
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  aria-label="Scroll to top of page"
  onclick="window.scrollTo({ top: 0, left: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })"
  class:list={[
    // Position — fixed bottom-right, above all page content
    "fixed bottom-5 right-5 z-[1000]",
    "max-[600px]:bottom-4 max-[600px]:right-4",
    // Shape + color
    "rounded-full bg-primary",
    // Icon color: white on dark-blue (light theme); dark on light-blue (dark theme)
    "text-white dark:text-[#0f172a]",
    // Padding keeps it ~52px (min 48px)
    "p-3",
    // Shadow
    "shadow-lg",
    // Min size accessibility — 48px desktop, 44px mobile
    "min-h-[48px] min-w-[48px] max-[600px]:min-h-[44px] max-[600px]:min-w-[44px]",
    // Hover
    "hover:-translate-y-0.5 hover:shadow-xl",
    // Focus
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
    // Transition (respects reduced-motion)
    "transition motion-reduce:transition-none",
    // Flex centering for icon
    "inline-flex items-center justify-center cursor-pointer",
  ]}
>
  <Icon name="mdi:chevron-up" class="h-6 w-6" aria-hidden="true" />
</button>
