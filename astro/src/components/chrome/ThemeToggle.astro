---
/**
 * ThemeToggle — Alpine-driven pill-shaped theme switch.
 *
 * Syncs with the no-flash script in BaseLayout via sessionStorage key "theme".
 * Reads the already-applied .dark class on mount (x-init) so initial state is
 * always correct regardless of SSR default.
 *
 * Gotchas:
 *  - sessionStorage ONLY — no localStorage, no cookies (#11)
 *  - No ripple/Material effects (#7)
 *  - Thumb transition respects prefers-reduced-motion
 *  - WCAG 2.5.3: the accessible name must contain the visible label. The label
 *    is always "Dark" and the name "Dark mode"; on/off is carried by
 *    aria-checked, the thumb and the icon. A label that flipped to "Light" was
 *    not in the name, so "click Light" did nothing for voice-control users.
 *    ("Dark mode" as the visible label wraps the header nav at 960-1010px.)
 *  - WCAG 1.4.11: track, thumb and icon each keep >= 3:1 against what they
 *    sit on, in both themes and at every width (the text label is hidden at
 *    480px and narrower, so the graphics alone must identify the switch).
 */
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  role="switch"
  aria-label="Dark mode"
  x-data="{ dark: true }"
  x-init="dark = document.documentElement.classList.contains('dark')"
  :aria-checked="dark.toString()"
  @click="
    dark = !dark;
    document.documentElement.classList.toggle('dark', dark);
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    sessionStorage.setItem('theme', dark ? 'dark' : 'light');
  "
  class:list={[
    // pill wrapper — matches legacy .theme-switch-wrapper rounded-[1.5rem] py-1 px-2
    "inline-flex items-center gap-2 rounded-[1.5rem] px-2 py-1",
    "bg-on-surface/5 hover:bg-on-surface/10",
    "dark:bg-white/5 dark:hover:bg-white/10",
    // focus ring — 3px primary outline (legacy focus style)
    "focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-2",
    // remove default button chrome (no bg-transparent/p-0 — they'd override the pill bg + padding above)
    "cursor-pointer select-none border-0",
    // 44px touch target: invisible ::after hit area, visual pill size unchanged
    "relative after:absolute after:inset-x-0 after:top-1/2 after:h-11 after:-translate-y-1/2 after:content-['']",
    // transition
    "transition-colors duration-200",
    className,
  ]}
>
  <!-- Sun/moon icon (aria-hidden) -->
  <!-- Moon: shown when dark -->
  <Icon
    name="mdi:weather-night"
    class="h-4 w-4 shrink-0 text-yellow-300 transition-colors duration-200"
    aria-hidden="true"
    x-show="dark"
  />
  <!-- Sun: shown when light -->
  <Icon
    name="mdi:white-balance-sunny"
    class="h-4 w-4 shrink-0 text-[#c2410c] transition-colors duration-200"
    aria-hidden="true"
    x-show="!dark"
  />

  <!-- CSS pill track + thumb (legacy: 2rem × 1rem track, 0.75rem thumb) -->
  <!--
    Track uses bg-primary when dark (on), on-surface/70 when light (off): >= 4.5:1
    against the pill (on-surface/20 was 1.47:1). Thumb is white on the light-theme
    track and background-dark on the light-blue dark-theme track (white was 1.8:1);
    it translates right when dark/on.
  -->
  <span
    :class="dark
      ? 'bg-primary'
      : 'bg-on-surface/70 dark:bg-on-surface/50'"
    class="relative inline-flex h-4 w-8 shrink-0 items-center rounded-full transition-colors duration-200 motion-reduce:transition-none"
    aria-hidden="true"
  >
    <span
      :class="dark ? 'translate-x-[18px]' : 'translate-x-[2px]'"
      class="inline-block h-3 w-3 rounded-full bg-white dark:bg-background shadow-sm transition-transform duration-200 motion-reduce:transition-none"
    ></span>
  </span>

  <!-- Visible label: always "Dark", the start of the name "Dark mode" — hidden below 480px -->
  <span
    class="max-[480px]:hidden text-sm font-medium text-on-surface dark:text-on-surface whitespace-nowrap"
  >Dark</span>

  <!-- Screen reader live region: announces theme change -->
  <span
    class="sr-only"
    aria-live="polite"
    x-text="dark ? 'Switched to dark mode' : 'Switched to light mode'"
  ></span>
</button>
