import { mount } from '@vue/test-utils';
import { describe, it, expect, beforeEach } from 'vitest';
import SearchInterface from '../../app/components/content/SearchInterface.vue';
import { createVuetify } from 'vuetify';
import * as components from 'vuetify/components';
import * as directives from 'vuetify/directives';

/**
 * SearchInterface Component Tests
 *
 * Tests for the search input component including:
 * - Search input rendering and behavior
 * - Model value binding
 * - Event emissions (update, clear, focus)
 * - Loading state
 * - Accessibility (ARIA labels, autofocus)
 * - Placeholder text behavior
 */

describe('SearchInterface Component', () => {
  let vuetify;
  let wrapper;

  beforeEach(() => {
    vuetify = createVuetify({
      components,
      directives,
    });
  });

  describe('Rendering', () => {
    it('renders search input field', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.find('.search-input');
      expect(textField.exists()).toBe(true);
    });

    it('renders within a card', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const card = wrapper.find('.v-card');
      expect(card.exists()).toBe(true);
    });

    it('has search icon prepended', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      // Vuetify text field should have prepend-inner-icon="mdi-magnify"
      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('prependInnerIcon')).toBe('mdi-magnify');
    });

    it('has clearable button', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('clearable')).toBe(true);
    });
  });

  describe('Model Value Binding', () => {
    it('displays initial model value', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: 'violence prevention'
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('modelValue')).toBe('violence prevention');
    });

    it('emits update:model-value when input changes', async () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: ''
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      await textField.vm.$emit('update:model-value', 'prevention');

      expect(wrapper.emitted('update:model-value')).toBeTruthy();
      expect(wrapper.emitted('update:model-value')[0]).toEqual(['prevention']);
    });

    it('updates placeholder based on model value', () => {
      const wrapperEmpty = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: ''
        }
      });

      const textFieldEmpty = wrapperEmpty.findComponent({ name: 'VTextField' });
      expect(textFieldEmpty.props('placeholder')).toBe('Enter search terms...');

      const wrapperFilled = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: 'test'
        }
      });

      const textFieldFilled = wrapperFilled.findComponent({ name: 'VTextField' });
      expect(textFieldFilled.props('placeholder')).toBe('');
    });
  });

  describe('Event Emissions', () => {
    it('emits clear event when clear button clicked', async () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: 'test'
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      await textField.vm.$emit('click:clear');

      expect(wrapper.emitted('clear')).toBeTruthy();
    });

    it('emits focus event when input focused', async () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      await textField.vm.$emit('focus');

      expect(wrapper.emitted('focus')).toBeTruthy();
    });
  });

  describe('Loading State', () => {
    it('shows loading indicator when searching', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          isSearching: true
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('loading')).toBe(true);
    });

    it('does not show loading indicator when not searching', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          isSearching: false
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('loading')).toBe(false);
    });
  });

  describe('Accessibility', () => {
    it('has aria-label attribute', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('ariaLabel')).toBe('Search content');
    });

    it('has autofocus enabled', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('autofocus')).toBe(true);
    });

    it('has appropriate label', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('label')).toBe('Search content');
    });
  });

  describe('Styling', () => {
    it('uses outlined variant', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('variant')).toBe('outlined');
    });

    it('hides details section', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.findComponent({ name: 'VTextField' });
      expect(textField.props('hideDetails')).toBe(true);
    });

    it('has search-input class', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      const textField = wrapper.find('.search-input');
      expect(textField.exists()).toBe(true);
    });
  });

  describe('Props', () => {
    it('accepts modelValue prop', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          modelValue: 'test value'
        }
      });

      expect(wrapper.props('modelValue')).toBe('test value');
    });

    it('accepts isSearching prop', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        },
        props: {
          isSearching: true
        }
      });

      expect(wrapper.props('isSearching')).toBe(true);
    });

    it('has default values for props', () => {
      wrapper = mount(SearchInterface, {
        global: {
          plugins: [vuetify]
        }
      });

      expect(wrapper.props('modelValue')).toBe('');
      expect(wrapper.props('isSearching')).toBe(false);
    });
  });
});
