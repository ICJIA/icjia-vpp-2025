{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run create:accessibility-html && npm run create:search-index && nuxt build",
    "dev": "npm run create:accessibility-html && npm run create:search-index && nuxt dev --port=8000 -o",
    "generate": "npm run create:accessibility-html && npm run create:search-index && nuxt generate",
    "generate:serve": "npm run create:accessibility-html && npm run create:search-index && nuxt generate && npx serve .output/public",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create:accessibility-html": "node scripts/create-accessibility-html.js",
    "create:search-index": "node scripts/generate-search-index.js"
  },
  "dependencies": {
    "@nuxt/content": "^3.5.1",
    "@vueuse/core": "^13.2.0",
    "@vueuse/head": "^2.0.0",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/router": "^13.2.0",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.2",
    "gray-matter": "^4.0.3",
    "nuxt": "^3.17.3",
    "rimraf": "^6.0.1",
    "serve": "^14.2.4",
    "vue": "^3.5.0",
    "vuetify": "^3.8.5"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@testing-library/vue": "^8.1.0",
    "@vitest/coverage-v8": "3.1.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^17.4.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "marked": "^15.0.11",
    "sass": "1.71.1",
    "vitest": "^3.1.3"
  },
  "packageManager": "yarn@1.22.22"
}
